{
  "name": "@robindevkota/agentinbox",
  "version": "0.1.1",
  "description": "AI-powered task inbox — clients submit bugs, Claude fixes them, everyone sees what happened.",
  "keywords": [
    "ai",
    "claude",
    "mcp",
    "task-inbox",
    "autonomous-agent",
    "bug-tracking"
  ],
  "author": "Robin Devkota",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robindevkota/AgentInbox.git"
  },
  "homepage": "https://github.com/robindevkota/AgentInbox#readme",
  "main": "dist/index.js",
  "bin": {
    "agentinbox": "dist/cli.js"
  },
  "files": [
    "dist/",
    "ui-dist/",
    "../../examples/claude-loop/projects.json"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc",
    "build:all": "cd ../ui && pnpm build && cd ../server && tsc && node scripts/copy-ui.js",
    "start": "node dist/cli.js start",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build:all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@slack/bolt": "^3.17.1",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-fileupload": "^1.4.3",
    "libsql": "^0.5.29",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.13",
    "pdf-parse": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.4.4",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
