# ── Server ─────────────────────────────────────────
PORT=3000
DATA_DIR=./data

# Optional API key for PM dashboard and admin API routes.
# If not set, all admin routes are open (fine for localhost self-hosted).
# Set this for any internet-facing deployment.
API_KEY=change-me-to-a-long-random-string

# ── Email (Phase 3: notifications + OTP auth) ──────
# Supports any SMTP provider (Gmail, Resend, Mailgun, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=AgentInbox <you@gmail.com>

# ── Slack (Phase 4: submit tasks from Slack) ───────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# ── White label (Phase 4) ──────────────────────────
# Override per-project via the project branding API instead
DEFAULT_BRAND_NAME=AgentInbox
DEFAULT_BRAND_COLOR=#0284c7
