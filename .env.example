# Port for the server (default: 3000)
PORT=3000

# Directory for SQLite database and uploaded files (default: ./data)
DATA_DIR=./data

# Optional API key for PM dashboard and admin API routes.
# If not set, all admin routes are open (fine for self-hosted, localhost use).
# Set this for any internet-facing deployment.
API_KEY=change-me-to-a-long-random-string
